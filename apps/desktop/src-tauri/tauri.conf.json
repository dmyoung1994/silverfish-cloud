{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silverfish",
  "version": "0.3.0",
  "identifier": "app.silverfish.collaborative",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silverfish",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* wss: https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../mcp-bridge/dist/server.mjs": "mcp-bridge/server.mjs",
      "../mcp-bridge/servers.json": "mcp-bridge/servers.json"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["silverfish"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBQTUzMUZEOUE0MTUxNzgKUldSNFVVR2EvVEdsR3EyQkVHdWZtN0I3WUNKbzhLN2k5M0puV1JVOG1hTnd6Qkd6cW8yWXF5QloK",
      "endpoints": ["https://try.silverfish-app.workers.dev/updates/latest.json"]
    }
  }
}
