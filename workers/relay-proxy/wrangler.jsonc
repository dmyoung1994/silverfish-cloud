{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "try",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../../apps/desktop/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "ENTITLEMENTS",
      "database_name": "silverfish-entitlements",
      "database_id": "20072e60-97f9-48a7-a617-a123723fcf35",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": [
      "RELAY_PROXY_SECRET",
      "STRIPE_WEBHOOK_SECRET"
    ]
  },
  "vars": {
    "EXPECTED_STRIPE_PAYMENT_LINK_ID": "plink_1TwaWm8BrcdmT7aM5jfn11nU",
    "ORIGIN_URL": "https://2600-1900-4041-40e-0-1-0-0.sslip.io",
    "PAID_MAX_GUESTS": "8",
    "FIREBASE_PROJECT_ID": "silverfish-app"
  }
}
