# Set this to use a deployed relay automatically and hide the relay prompt.
VITE_SILVERFISH_RELAY_URL=
# Legacy builds also recognize VITE_CO_DEX_RELAY_URL.

# Optional public site used for browser invite links. When unset, the relay
# serves invite pages itself.
VITE_SILVERFISH_PUBLIC_URL=

# These settings are only for official managed-service builds. Leave the flag
# false or unset in open-source/self-hosted builds to omit all subscription UI.
VITE_SILVERFISH_MANAGED_SERVICE=false
# Public Stripe-hosted checkout URL for the $15/month Founding Host
# subscription. Keep Stripe credentials out of the app and repository.
VITE_SILVERFISH_SUBSCRIBE_URL=

# Optional relay-side limits. A zero or empty lifetime means no hard deadline.
# The hosted Silverfish preview uses 1 guest and 3600 seconds; self-hosters
# can choose their own values.
SILVERFISH_MAX_GUESTS_PER_ROOM=32
SILVERFISH_ROOM_LIFETIME_SECONDS=0

# Managed relay only. When a shared proxy secret is configured on both the
# Cloudflare Worker and relay origin, active Founding Host subscriptions can
# create 8-guest rooms without a hard deadline. Self-hosters should leave the
# secret unset.
SILVERFISH_PAID_MAX_GUESTS_PER_ROOM=8
SILVERFISH_PAID_ROOM_LIFETIME_SECONDS=0
SILVERFISH_RELAY_PROXY_SECRET=
